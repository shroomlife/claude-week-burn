# GitHub OAuth — required to enable Sign-In + Gist Sync.
# Without this, the "Sign in" pill is hidden and the app stays localStorage-only.
#
# 1. Go to https://github.com/settings/developers
# 2. New OAuth App
# 3. Application name: "Claude Burn Rate"
# 4. Homepage URL: https://shroomlife.github.io/claude-week-burn/
# 5. Authorization callback URL: https://shroomlife.github.io/claude-week-burn/
# 6. CHECK "Enable Device Flow"
# 7. Copy the Client ID into this var
VITE_GITHUB_CLIENT_ID=

# CORS proxy URL for the OAuth Device Flow.
# Default points at the deployed Cloudflare Worker. Override if you fork.
VITE_GH_PROXY_URL=https://burn-rate-gh-proxy.shroomlife.workers.dev
